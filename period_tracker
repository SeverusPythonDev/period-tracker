# === FSM СОСТОЯНИЯ ===
class CycleTracker(StatesGroup):
    waiting_period_start = State()
    waiting_cycle_length = State()

# === SUPABASE ===
def get_db_connection():
    """Подключение к Supabase PostgreSQL"""
    return psycopg2.connect(DB_URL)

def init_db():
    """Создаёт таблицу users"""
    try:
        with get_db_connection() as conn:
            with conn.cursor() as cursor:
                cursor.execute("""
                    CREATE TABLE IF NOT EXISTS users (
                        user_id BIGINT PRIMARY KEY,
                        last_period_start TEXT NOT NULL,
                        cycle_length INTEGER NOT NULL,
                        created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
                    )
                """)
                conn.commit()
                logger.info("✅ Supabase таблица готова!")
    except Exception as e:
        logger.error(f"❌ Supabase: {e}")
        raise

def save_user_data(user_id: int, last_period: date, cycle_length: int):
    """Сохранение данных пользователя"""
    try:
        with get_db_connection() as conn:
            with conn.cursor() as cursor:
                cursor.execute("""
                    INSERT INTO users (user_id, last_period_start, cycle_length)
                    VALUES (%s, %s, %s)
                    ON CONFLICT (user_id) DO UPDATE SET
                        last_period_start = EXCLUDED.last_period_start,
                        cycle_length = EXCLUDED.cycle_length
                """, (user_id, last_period.isoformat(), cycle_length))
                conn.commit()
    except Exception as e:
        logger.error(f"❌ Сохранение: {e}")

def get_user_data(user_id: int):
    """Получение данных пользователя"""
    try:
        with get_db_connection() as conn:
            with conn.cursor() as cursor:
                cursor.execute(
                    "SELECT last_period_start, cycle_length FROM users WHERE user_id = %s",
                    (user_id,)
                )
                row = cursor.fetchone()
                if row:
                    return {
                        "last_period_start": date.fromisoformat(row[0]),
                        "cycle_length": row[1]
                    }
        return None
    except Exception as e:
        logger.error(f"❌ Получение данных: {e}")
        return None

def delete_user_data(user_id: int):
    """Удаление данных"""
    try:
        with get_db_connection() as conn:
            with conn.cursor() as cursor:
                cursor.execute("DELETE FROM users WHERE user_id = %s", (user_id,))
                conn.commit()
    except Exception as e:
        logger.error(f"❌ Удаление: {e}")

# 🔥 AIOGRAM 3 HANDLERS С КНОПКАМИ ✅
@dp.message(Command("start"))
async def start_handler(message: Message, state: FSMContext):
    """🔥 /start с главной клавиатурой"""
    await message.answer(
        "🌸 *Добро пожаловать в трекер циклов!*\n\n"
        "Укажите дату *последней* менструации:\n"
        "`2026-02-01` (ГГГГ-ММ-ДД)",
        reply_markup=main_kb,  # ← ОСНОВНАЯ КЛАВИАТУРА!
        parse_mode="Markdown"
    )
    await state.set_state(CycleTracker.waiting_period_start)

@dp.message(F.text == "📊 Мой цикл")
async def my_cycle(message: Message):
    """🔥 Кнопка 'Мой цикл'"""
    user_id = message.from_user.id
    data = get_user_data(user_id)
    
    if not data:
        await message.answer(
            "📝 Настройте данные командой /start",
            reply_markup=main_kb
        )
        return
    
    last_period = data["last_period_start"]
    cycle_length = data["cycle_length"]
    days_since = (date.today() - last_period).days
    next_period = last_period + timedelta(days=cycle_length)
    days_to_next = (next_period - date.today()).days
    
    status = "🔴 *Менструация*" if days_since <= 5 else \
             f"🟢 День {days_since + 1}/{cycle_length}"
    
    await message.answer(
        f"📊 *СТАТУС ЦИКЛА*\n\n"
        f"{status}\n\n"
        f"📅 Следующая: `{next_period.strftime('%d.%m.%Y')}`\n"
        f"⏳ Осталось: *{days_to_next}* дней",
        reply_markup=cycle_kb,  # ← КЛАВИАТУРА ФАЗ!
        parse_mode="Markdown"
    )

